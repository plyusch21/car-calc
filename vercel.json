{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "diag.html", "use": "@vercel/static" },
    { "src": "share.html", "use": "@vercel/static" },
    { "src": "deals.html", "use": "@vercel/static" },
    { "src": "logo.png", "use": "@vercel/static" },
    { "src": "logo-kp.png", "use": "@vercel/static" },
    { "src": "manifest.webmanifest", "use": "@vercel/static" },
    { "src": "sw.js", "use": "@vercel/static" },
    { "src": "offline.html", "use": "@vercel/static" },
    { "src": "icons/*.png", "use": "@vercel/static" },
    { "src": "lib/calc.js", "use": "@vercel/static" },
    { "src": "api/rates.js", "use": "@vercel/node" },
    { "src": "api/customs.js", "use": "@vercel/node" },
    { "src": "api/auth.js", "use": "@vercel/node" },
    { "src": "api/login.js", "use": "@vercel/node" },
    { "src": "api/admin.js", "use": "@vercel/node" },
    { "src": "api/state.js", "use": "@vercel/node" },
    { "src": "api/parse-listing.js", "use": "@vercel/node" },
    { "src": "api/share-relay.js", "use": "@vercel/node" },
    { "src": "api/deals.js", "use": "@vercel/node" },
    { "src": "api/rates-refresh.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/rates", "dest": "/api/rates.js" },
    { "src": "/api/customs", "dest": "/api/customs.js" },
    { "src": "/api/auth", "dest": "/api/auth.js" },
    { "src": "/api/login", "dest": "/api/login.js" },
    { "src": "/api/admin", "dest": "/api/admin.js" },
    { "src": "/api/state", "dest": "/api/state.js" },
    { "src": "/api/parse-listing", "dest": "/api/parse-listing.js" },
    { "src": "/api/share-relay", "dest": "/api/share-relay.js" },
    { "src": "/api/deals", "dest": "/api/deals.js" },
    { "src": "/api/rates-refresh", "dest": "/api/rates-refresh.js" },
    { "src": "/diag", "dest": "/diag.html" },
    { "src": "/share", "dest": "/share.html" },
    { "src": "/deals", "dest": "/deals.html" },
    { "src": "/logo.png", "dest": "/logo.png" },
    { "src": "/logo-kp.png", "dest": "/logo-kp.png" },
    { "src": "/manifest.webmanifest", "dest": "/manifest.webmanifest", "headers": { "Content-Type": "application/manifest+json", "Cache-Control": "no-cache" } },
    { "src": "/sw.js", "dest": "/sw.js", "headers": { "Content-Type": "application/javascript; charset=utf-8", "Cache-Control": "no-cache" } },
    { "src": "/offline.html", "dest": "/offline.html" },
    { "src": "/icons/(.*)", "dest": "/icons/$1" },
    { "src": "/lib/(.*)", "dest": "/lib/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "crons": [
    { "path": "/api/rates-refresh", "schedule": "0 0 * * *" }
  ]
}
